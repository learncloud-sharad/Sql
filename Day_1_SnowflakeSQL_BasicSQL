SELECT COUNT(*) AS rows_inserted
FROM orders;

-- View all records
SELECT *
FROM orders
ORDER BY order_id;

-- Check available order statuses
SELECT DISTINCT status
FROM orders
ORDER BY status;

-- Calculate net amount after discount
SELECT
    order_id,
    customer_name,
    total_amount,
    discount_pct,
    total_amount * (
        1 - COALESCE(discount_pct, 0) / 100
    ) AS net_amount
FROM orders
ORDER BY order_id;

